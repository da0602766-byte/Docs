ORIGEM_FRONTEND=http://127.0.0.1:5175
# Somente no backend: pooler de sessão (5432) local ou transações (6543) na Vercel.
# Na Vercel, ORIGEM_FRONTEND deve ser a origem HTTPS exata do frontend.
DATABASE_URL=
CHAVE_DO_TOKEN=
# Somente para executar testes: schema descartável criado por um administrador.
SUPABASE_ESQUEMA_TESTE=
# Simulação: participação do morador sobre a média da faixa de cada material.
PERCENTUAL_MORADOR=50
CAPACIDADE_HORARIO=3
HORARIOS_COLETA=08:00,09:00,10:00,11:00,13:00,14:00,15:00,16:00

# Opcional: entrega real de recuperação via SMTP com STARTTLS.
# O preview_teste ativa a caixa local automaticamente, sem SMTP.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# IA: preencha as chaves somente em backend/.env ou no ambiente da API.
# Mantenha 0 durante a preparação. O futuro recurso usará um provedor por vez.
IA_HABILITADA=0
IA_PROVEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
